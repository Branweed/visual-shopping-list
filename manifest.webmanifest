{
  "id": "./",
  "name": "Visual Shopping List",
  "short_name": "Shopping",
  "description": "A shared grocery list with photos, aisles and prices, a pantry, meal plans and price history for your household.",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "food",
    "shopping",
    "lifestyle",
    "productivity"
  ],
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e9eeeb",
  "theme_color": "#17614a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share-title",
      "text": "share-text",
      "url": "share-url"
    }
  },
  "shortcuts": [
    {
      "name": "Add an item",
      "short_name": "Add item",
      "description": "Add something to the shopping list",
      "url": "./?go=add",
      "icons": [
        {
          "src": "sc-add.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Shop mode",
      "short_name": "Shop",
      "description": "Shop one store aisle by aisle",
      "url": "./?go=shop",
      "icons": [
        {
          "src": "sc-shop.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Scan a receipt",
      "short_name": "Receipt",
      "description": "Update prices and save the trip",
      "url": "./?go=receipt",
      "icons": [
        {
          "src": "sc-receipt.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
