rules_version = '2';

// Visual Shopping List: security rules
// ------------------------------------
// - Nobody can read or write anything without signing in with a verified email.
// - Items and stores (the original inventory and stores collections) are one shared catalog:
//   everyone signed in can see it; only admins add, change or delete. Others keep private copies
//   of their edits and can send change requests to the admin.
// - Lists, pantry, calendar and members live inside a household that only its members can see.
// - Price history, saved recipes and personal item edits are private to each person.
// - Only the household owner can invite, remove people, rename or delete it.
// - Joining needs an unexpired invite code made by the owner.
// - Every write is checked for allowed fields, types and sizes.
// - Anything not listed here is locked.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is asking ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function verified() {
      return signedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }
    function isMember(hid) {
      return verified() &&
        exists(/databases/$(database)/documents/households/$(hid)/members/$(me()));
    }
    function isAdmin() {
      return verified() && exists(/databases/$(database)/documents/admins/$(me()));
    }
    function isOwner(hid) {
      return verified() &&
        get(/databases/$(database)/documents/households/$(hid)).data.ownerUid == me();
    }

    // ---------- field checks ----------
    function str(v, minLen, maxLen) { return v is string && v.size() >= minLen && v.size() <= maxLen; }
    function optStr(d, k, maxLen) { return !(k in d) || str(d[k], 0, maxLen); }
    function optNum(d, k) { return !(k in d) || d[k] is number; }
    function optBool(d, k) { return !(k in d) || d[k] is bool; }
    function okPrice(d) {
      return !('price' in d) ||
        (d.price is string && d.price.matches('^([0-9]{1,6}([.][0-9]{1,2})?)?$'));
    }
    function okImage(d) {
      return !('image' in d) || (
        d.image is string && d.image.size() <= 300000 && (
          d.image == '' ||
          d.image.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$') ||
          d.image.matches('^https://[^ "<>]+$')
        )
      );
    }
    function okPer(d) {
      return !('per' in d) || d.per in ['', 'lb'];
    }
    function okUpc(d) {
      return !('upc' in d) || (d.upc is string && d.upc.matches('^([0-9]{8,14})?$'));
    }
    function validAisleMap(d) {
      return d.keys().hasOnly(['store', 'aisles', 'updatedAt', 'updatedBy']) &&
        str(d.store, 1, 80) && d.aisles is list && d.aisles.size() <= 120 &&
        optNum(d, 'updatedAt') && (!('updatedBy' in d) || d.updatedBy == me());
    }
    function sameCreator(d, field) {
      return d.get(field, '') == resource.data.get(field, '');
    }

    function validHousehold(d) {
      return d.keys().hasOnly(['name', 'ownerUid', 'createdAt', 'updatedAt']) &&
        str(d.name, 1, 60) && d.ownerUid is string &&
        optNum(d, 'createdAt') && optNum(d, 'updatedAt');
    }
    function validMember(d) {
      return d.keys().hasOnly(['role', 'name', 'email', 'joinedAt', 'invite']) &&
        d.role in ['owner', 'member'] &&
        optStr(d, 'name', 80) &&
        (!('email' in d) || d.email == request.auth.token.email) &&
        optNum(d, 'joinedAt') &&
        (!('invite' in d) || (d.invite is string && d.invite.matches('^[A-Za-z0-9]{16,40}$')));
    }
    function inviteValid(hid, code) {
      let inv = get(/databases/$(database)/documents/invites/$(code));
      return inv.data.householdId == hid && inv.data.expiresAt > request.time;
    }
    function validItem(d) {
      return d.keys().hasOnly(['name', 'store', 'aisle', 'price', 'image', 'upc', 'per',
                               'createdAt', 'updatedAt', 'createdBy', 'updatedBy']) &&
        str(d.name, 1, 120) && str(d.store, 1, 80) &&
        optStr(d, 'aisle', 40) && okPrice(d) && okImage(d) && okUpc(d) && okPer(d) &&
        optNum(d, 'createdAt') && optNum(d, 'updatedAt') &&
        d.createdBy is string &&
        (!('updatedBy' in d) || d.updatedBy == me());
    }
    function validStore(d) {
      return d.keys().hasOnly(['name', 'createdAt', 'createdBy']) &&
        str(d.name, 1, 80) && optNum(d, 'createdAt') && d.createdBy is string;
    }
    function validList(d) {
      return d.keys().hasOnly(['name', 'createdAt', 'createdBy']) &&
        str(d.name, 1, 60) && optNum(d, 'createdAt') && d.createdBy is string;
    }
    function validListItem(d) {
      return d.keys().hasOnly(['name', 'store', 'aisle', 'price', 'image', 'addedAt',
                               'inCart', 'qty', 'inventoryId', 'addedBy', 'note', 'per', 'lbs']) &&
        str(d.name, 1, 120) && optStr(d, 'store', 80) && optStr(d, 'aisle', 40) && optStr(d, 'note', 80) &&
        okPer(d) && (!('lbs' in d) || (d.lbs is number && d.lbs > 0 && d.lbs <= 100)) &&
        okPrice(d) && okImage(d) && optNum(d, 'addedAt') && optBool(d, 'inCart') &&
        (!('qty' in d) || (d.qty is int && d.qty >= 1 && d.qty <= 999)) &&
        (!('inventoryId' in d) || d.inventoryId == null || str(d.inventoryId, 1, 64)) &&
        d.addedBy is string;
    }
    function validPantry(d) {
      return d.keys().hasOnly(['name', 'where', 'level', 'qty', 'note', 'expires', 'est', 'upc',
                               'addedAt', 'updatedAt', 'addedBy']) &&
        str(d.name, 1, 120) &&
        (!('where' in d) || d.where in ['fridge', 'freezer', 'pantry', 'other']) &&
        (!('level' in d) || d.level in ['plenty', 'low', 'out']) &&
        (!('qty' in d) || (d.qty is int && d.qty >= 1 && d.qty <= 999)) &&
        optStr(d, 'note', 80) && optBool(d, 'est') && okUpc(d) &&
        (!('expires' in d) || (d.expires is string && d.expires.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$'))) &&
        optNum(d, 'addedAt') && optNum(d, 'updatedAt') &&
        d.addedBy is string;
    }
    function validPrices(d) {
      return d.keys().hasOnly(['name', 'pts', 'updatedAt']) &&
        str(d.name, 1, 120) && d.pts is list && d.pts.size() <= 60 && optNum(d, 'updatedAt');
    }
    function validEvent(d) {
      return d.keys().hasOnly(['title', 'date', 'createdAt', 'createdBy']) &&
        str(d.title, 1, 140) &&
        d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        optNum(d, 'createdAt') && d.createdBy is string;
    }
    function validRecipe(d) {
      return d.keys().hasOnly(['name', 'type', 'minutes', 'waitMinutes', 'waitNote', 'serves', 'summary', 'uses', 'missing',
                               'ingredients', 'steps', 'notes', 'savedAt']) &&
        str(d.name, 1, 80) && optStr(d, 'type', 20) && optNum(d, 'minutes') && optNum(d, 'serves') &&
        optNum(d, 'waitMinutes') && optStr(d, 'waitNote', 80) && optStr(d, 'notes', 500) &&
        optStr(d, 'summary', 200) &&
        (!('uses' in d) || (d.uses is list && d.uses.size() <= 12)) &&
        (!('missing' in d) || (d.missing is list && d.missing.size() <= 12)) &&
        d.ingredients is list && d.ingredients.size() <= 30 &&
        d.steps is list && d.steps.size() <= 20 &&
        optNum(d, 'savedAt');
    }
    function validMine(d) {
      return d.keys().hasOnly(['name', 'store', 'aisle', 'price', 'image', 'upc', 'per', 'own', 'updatedAt']) &&
        str(d.name, 1, 120) && str(d.store, 1, 80) && optStr(d, 'aisle', 40) &&
        okPrice(d) && okImage(d) && okUpc(d) && okPer(d) && optBool(d, 'own') && optNum(d, 'updatedAt');
    }
    function validRequest(d) {
      return d.keys().hasOnly(['kind', 'itemId', 'name', 'store', 'aisle', 'price', 'image', 'upc', 'per', 'aisles', 'note',
                               'by', 'byName', 'byEmail', 'createdAt']) &&
        d.kind in ['change', 'add', 'aisles'] &&
        okUpc(d) && okPer(d) && (!('aisles' in d) || (d.aisles is list && d.aisles.size() <= 120)) &&
        (!('itemId' in d) || d.itemId == null || str(d.itemId, 1, 64)) &&
        str(d.name, 1, 120) && str(d.store, 1, 80) && optStr(d, 'aisle', 40) &&
        okPrice(d) && okImage(d) && optStr(d, 'note', 300) && optStr(d, 'byName', 80) &&
        (!('byEmail' in d) || d.byEmail == request.auth.token.email) &&
        d.createdAt is number;
    }
    function validUser(d) {
      return d.keys().hasOnly(['households', 'activeHousehold', 'createdAt', 'updatedAt']) &&
        (!('households' in d) || (d.households is map && d.households.size() <= 25)) &&
        (!('activeHousehold' in d) || d.activeHousehold == null || str(d.activeHousehold, 1, 64)) &&
        optNum(d, 'createdAt') && optNum(d, 'updatedAt');
    }
    function validInvite(d) {
      return d.keys().hasOnly(['householdId', 'householdName', 'createdBy', 'createdAt',
                               'expiresAt', 'role']) &&
        d.householdId is string && d.householdId.matches('^[A-Za-z0-9]{1,40}$') &&
        str(d.householdName, 1, 60) &&
        d.createdBy == me() && optNum(d, 'createdAt') &&
        d.role == 'member' &&
        d.expiresAt is timestamp &&
        d.expiresAt > request.time &&
        d.expiresAt < request.time + duration.value(8, 'd');
    }

    // ---------- your own account record ----------
    match /users/{uid} {
      allow read: if signedIn() && uid == me();
      allow create, update: if verified() && uid == me() && validUser(request.resource.data);
      allow delete: if signedIn() && uid == me();

      // Your saved recipes. Private to you.
      match /recipes/{id} {
        allow read, delete: if signedIn() && uid == me();
        allow create, update: if verified() && uid == me() &&
          id.matches('^[A-Za-z0-9_-]{1,64}$') && validRecipe(request.resource.data);
      }

      // Your own aisle map for a store, until the admin adds it for everyone.
      match /aisleMaps/{id} {
        allow read, delete: if signedIn() && uid == me();
        allow create, update: if verified() && uid == me() &&
          id.matches('^[a-z0-9-]{1,60}$') && validAisleMap(request.resource.data);
      }

      // Your price history: what things cost where, from prices you save, tags and receipts. Private to you.
      match /prices/{id} {
        allow read, delete: if signedIn() && uid == me();
        allow create, update: if verified() && uid == me() &&
          id.matches('^[a-z0-9-]{1,60}$') && validPrices(request.resource.data);
      }

      // Your private versions of items. Nobody else can see or change them.
      match /myItems/{id} {
        allow read, delete: if signedIn() && uid == me();
        allow create, update: if verified() && uid == me() &&
          id.matches('^[A-Za-z0-9_-]{1,64}$') && validMine(request.resource.data);
      }
    }

    // ---------- requests to the admin to change or add an item ----------
    match /requests/{id} {
      allow create: if verified() && validRequest(request.resource.data) &&
        request.resource.data.by == me();
      allow get: if isAdmin() || (verified() && resource.data.by == me());
      allow list: if isAdmin() || (verified() && resource.data.by == me());
      allow delete: if isAdmin() || (verified() && resource.data.by == me());
      allow update: if false;
    }

    // ---------- invite codes ----------
    // Anyone signed in who has the exact code can look at that one invite.
    // Nobody can browse invites except their creator.
    match /invites/{code} {
      allow get: if verified();
      allow list: if verified() && resource.data.createdBy == me();
      allow create: if verified() && code.matches('^[A-Za-z0-9]{16,40}$') &&
        validInvite(request.resource.data) &&
        isOwner(request.resource.data.householdId);
      allow delete: if verified() &&
        (resource.data.createdBy == me() || isOwner(resource.data.householdId));
      allow update: if false;
    }

    // ---------- the shared catalog (your original items and stores) ----------
    // Everyone signed in with a verified account can see it. Only admins can add, change or delete.
    // Everyone else's edits go to their own private copy (users/{uid}/myItems) or a request to the admin.
    // Edits are checked field by field, so older items with extra fields can still be edited.
    function itemChangeOk() {
      let d = request.resource.data;
      let ch = d.diff(resource.data).affectedKeys();
      return ch.hasOnly(['name', 'store', 'aisle', 'price', 'image', 'upc', 'per', 'updatedAt', 'updatedBy']) &&
        (!('upc' in ch) || okUpc(d)) && (!('per' in ch) || okPer(d)) &&
        (!('name' in ch) || str(d.name, 1, 120)) &&
        (!('store' in ch) || str(d.store, 1, 80)) &&
        (!('aisle' in ch) || str(d.aisle, 0, 40)) &&
        (!('price' in ch) || okPrice(d)) &&
        (!('image' in ch) || okImage(d)) &&
        (!('updatedAt' in ch) || d.updatedAt is number) &&
        (!('updatedBy' in ch) || d.updatedBy == me());
    }
    match /inventory/{id} {
      allow read: if verified();
      allow create: if isAdmin() && validItem(request.resource.data) &&
        request.resource.data.createdBy == me();
      allow update: if isAdmin() && itemChangeOk();
      allow delete: if isAdmin();
    }
    // Aisle maps: what's in each aisle of a store, from the signs. Everyone sees them; only admins change them.
    match /aisleMaps/{id} {
      allow read: if verified();
      allow create, update: if isAdmin() && id.matches('^[a-z0-9-]{1,60}$') && validAisleMap(request.resource.data);
      allow delete: if isAdmin();
    }
    match /stores/{id} {
      allow read: if verified();
      allow create: if isAdmin() && validStore(request.resource.data) &&
        request.resource.data.createdBy == me();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- rules version marker ----------
    // The app reads this to confirm the newest rules are published. Change the version when the rules change.
    match /_rules/{v} {
      allow get: if signedIn() && v == 'v18';
    }

    // ---------- admins ----------
    // Admins are added by hand in the Firebase console. The app can never change this list.
    match /admins/{uid} {
      allow get: if signedIn() && uid == me();
      allow write: if false;
    }

    // ---------- households ----------
    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if verified() &&
        validHousehold(request.resource.data) &&
        request.resource.data.ownerUid == me() &&
        existsAfter(/databases/$(database)/documents/households/$(hid)/members/$(me()));
      allow update: if isOwner(hid) &&
        validHousehold(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner(hid);

      match /members/{uid} {
        allow read: if isMember(hid);
        allow create: if verified() && uid == me() && validMember(request.resource.data) && (
          // Founding owner: the household is being created in this same write.
          (request.resource.data.role == 'owner' &&
            !exists(/databases/$(database)/documents/households/$(hid)) &&
            getAfter(/databases/$(database)/documents/households/$(hid)).data.ownerUid == me())
          ||
          // Joining with a valid, unexpired invite for this household.
          (request.resource.data.role == 'member' &&
            exists(/databases/$(database)/documents/households/$(hid)) &&
            inviteValid(hid, request.resource.data.invite))
        );
        allow update: if false;
        allow delete: if verified() && (
          (uid == me() && !isOwner(hid)) ||                     // a member leaving
          (uid != me() && isOwner(hid)) ||                      // owner removing someone
          (uid == me() && !existsAfter(/databases/$(database)/documents/households/$(hid)))  // owner deleting the household
        );
      }

      match /events/{id} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid) && validEvent(request.resource.data) &&
          request.resource.data.createdBy == me();
        allow update: if isMember(hid) && validEvent(request.resource.data) &&
          sameCreator(request.resource.data, 'createdBy');
      }

      // What's at home. Everyone in the household sees and updates it, like the lists.
      match /pantry/{id} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid) && validPantry(request.resource.data) &&
          request.resource.data.addedBy == me();
        allow update: if isMember(hid) && validPantry(request.resource.data) &&
          sameCreator(request.resource.data, 'addedBy');
      }

      match /lists/{listId} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid) && validList(request.resource.data) &&
          request.resource.data.createdBy == me();
        allow update: if isMember(hid) && validList(request.resource.data) &&
          sameCreator(request.resource.data, 'createdBy');

        match /items/{itemId} {
          allow read, delete: if isMember(hid);
          allow create: if isMember(hid) && validListItem(request.resource.data) &&
            request.resource.data.addedBy == me();
          allow update: if isMember(hid) && validListItem(request.resource.data) &&
            sameCreator(request.resource.data, 'addedBy');
        }
      }
    }

    // Nutrition read from label photos, shared by everyone in the household.
    match /households/{h}/nutrition/{id} {
      allow read, delete: if signedIn() &&
        exists(/databases/$(database)/documents/households/$(h)/members/$(request.auth.uid));
      allow create, update: if signedIn() &&
        exists(/databases/$(database)/documents/households/$(h)/members/$(request.auth.uid)) &&
        id.matches('^[ui][A-Za-z0-9_-]{1,60}$') &&
        request.resource.data.keys().hasOnly(['v', 't', 'by']) &&
        request.resource.data.v is string && request.resource.data.v.size() <= 4000 &&
        request.resource.data.t is number && request.resource.data.by == request.auth.uid;
    }

    // 💵 Trips: each receipt's total, for monthly spending. Shared by the household.
    match /households/{h}/trips/{id} {
      allow read, delete: if signedIn() &&
        exists(/databases/$(database)/documents/households/$(h)/members/$(request.auth.uid));
      allow create, update: if signedIn() &&
        exists(/databases/$(database)/documents/households/$(h)/members/$(request.auth.uid)) &&
        request.resource.data.keys().hasOnly(['store', 'total', 'd', 'n', 'est', 'list', 'src', 'by', 't']) &&
        request.resource.data.store is string && request.resource.data.store.size() > 0 && request.resource.data.store.size() <= 80 &&
        request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total < 100000 &&
        request.resource.data.d is number && request.resource.data.n is number &&
        (request.resource.data.est == null || request.resource.data.est is number) &&
        request.resource.data.list is string && request.resource.data.list.size() <= 60 &&
        request.resource.data.src in ['receipt', 'typed'] &&
        request.resource.data.t is number && request.resource.data.by == request.auth.uid;
    }

    // 🔁 Usual items: when things were bought, to suggest what's due again. Shared by the household.
    match /households/{h}/usual/{id} {
      allow read, delete: if signedIn() &&
        exists(/databases/$(database)/documents/households/$(h)/members/$(request.auth.uid));
      allow create, update: if signedIn() &&
        exists(/databases/$(database)/documents/households/$(h)/members/$(request.auth.uid)) &&
        id.matches('^[a-z0-9-]{1,80}$') &&
        request.resource.data.keys().hasOnly(['n', 's', 'i', 'ds', 't', 'by']) &&
        request.resource.data.n is string && request.resource.data.n.size() <= 120 &&
        request.resource.data.s is string && request.resource.data.s.size() <= 80 &&
        request.resource.data.i is string && request.resource.data.i.size() <= 64 &&
        request.resource.data.ds is list && request.resource.data.ds.size() <= 12 &&
        request.resource.data.t is number && request.resource.data.by == request.auth.uid;
    }

    // 🧾 Receipt matches ("MB GRD BF 80" = Ground Beef), shared so everyone's receipts match.
    match /households/{h}/aliases/{id} {
      allow read, delete: if signedIn() &&
        exists(/databases/$(database)/documents/households/$(h)/members/$(request.auth.uid));
      allow create, update: if signedIn() &&
        exists(/databases/$(database)/documents/households/$(h)/members/$(request.auth.uid)) &&
        id.matches('^[a-z0-9_-]{1,80}$') &&
        request.resource.data.keys().hasOnly(['k', 'i', 'by', 't']) &&
        request.resource.data.k is string && request.resource.data.k.size() <= 120 &&
        request.resource.data.i is string && request.resource.data.i.size() <= 64 &&
        request.resource.data.t is number && request.resource.data.by == request.auth.uid;
    }

    // Everything else is denied.
  }
}
